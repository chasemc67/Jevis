# Copy to .env and fill in locally. Never commit real keys.
# Required for live microphone and WAV streaming STT:
DEEPGRAM_API_KEY=
# Required for real Jev filtering, including JSON fixture replay:
AI_GATEWAY_API_KEY=

# Phase 0 implements this STT provider and this Gateway-only evaluation model.
STT_PROVIDER=deepgram
JEV_MODEL=typesafe-ai/jev

# Gate and sliding-window defaults from ARCHITECTURE.md.
JEV_EVERY_N_WORDS=1
DEBOUNCE_MS=1500
T_DIR_CONFIDENCE=0.6
T_NOUL=0.6
K=8
WINDOW_MAX_WORDS=40
REGION_SILENCE_MS=1500

# Total Jev evaluation deadline, including the one permitted transient retry.
JEV_TIMEOUT_MS=4000
GATEWAY_ZERO_DATA_RETENTION=false

# Homebrew SoX supplies CoreAudio capture; default uses the macOS input device.
SOX_PATH=sox
MIC_DEVICE=default
# Local RMS/dBFS diagnostics only. Audio levels never decide intent.
DEBUG_AUDIO=false
