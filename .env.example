# Copy to .env and fill in locally. Never commit real keys.
# One key for live microphone/WAV streaming STT and real Jev filtering.
# Offline fixture demos work without any key.
AI_GATEWAY_API_KEY=

# Both streaming STT models use AI Gateway. The demo UI can switch models live.
STT_PROVIDER=gateway
STT_MODEL=openai/gpt-realtime-whisper
# STT_MODEL=xai/grok-stt
JEV_MODEL=typesafe-ai/jev

# Deepgram is optional/deferred; only used when explicitly selecting its provider.
# STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# Gate and sliding-window defaults from ARCHITECTURE.md.
JEV_EVERY_N_WORDS=1
DEBOUNCE_MS=1500
T_DIR_CONFIDENCE=0.6
T_NOUL=0.6
K=8
WINDOW_MAX_WORDS=40
REGION_SILENCE_MS=1500

# Total Jev evaluation deadline, including the one permitted transient retry.
JEV_TIMEOUT_MS=4000
GATEWAY_ZERO_DATA_RETENTION=false

# Homebrew SoX supplies CoreAudio capture; default uses the macOS input device.
SOX_PATH=sox
MIC_DEVICE=default
# Local RMS/dBFS diagnostics only. Audio levels never decide intent.
DEBUG_AUDIO=false
